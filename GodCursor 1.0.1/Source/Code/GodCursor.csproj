<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GodCursor</AssemblyName>
    <RootNamespace>GodCursor</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <OutputPath>..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Folder with the game's and Harmony's DLLs. Override: dotnet build -p:Libs="C:\...\RimWorldWin64_Data\Managed" -->
    <Libs Condition="'$(Libs)' == ''">$(MSBuildProjectDirectory)\..\..\libs</Libs>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <UnityDlls Include="$(Libs)\UnityEngine*.dll" />
    <Reference Include="$(Libs)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Libs)\0Harmony.dll" Private="false" />
    <Reference Include="@(UnityDlls)" Private="false" />
  </ItemGroup>

</Project>
